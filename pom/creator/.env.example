# Optional overrides. Leave unset for localhost and the current Pages paths.
# No secrets belong in VITE_* variables: they are included in public bundles.
# VITE_PUBLIC_SITE_URL=https://santiesteban.github.io/games/
# VITE_GAME_URL=https://santiesteban.github.io/games/pom/
# VITE_CREATOR_URL=https://santiesteban.github.io/games/pom/creator/
# VITE_PLAYTEST_URL=https://santiesteban.github.io/games/pom/playtest/
# VITE_SHARE_GAME_URL=https://santiesteban.github.io/games/pom/
# Proof-of-concept only. Leave both unset to hide submission UI.
# VITE_COMMUNITY_SUBMIT_URL=https://YOUR-SUBMISSION-WORKER.workers.dev/submit
# VITE_COMMUNITY_TURNSTILE_SITE_KEY=PUBLIC_SITE_KEY
# VITE_COMMUNITY_GALLERY_URL=https://example.com/community-gallery.html
# VITE_COMMUNITY_GALLERY_API=https://YOUR-REVIEW-WORKER.workers.dev/gallery
# VITE_COMMUNITY_ADMIN_URL=https://YOUR-ACCESS-PROTECTED-REVIEW-WORKER.workers.dev/

# VITE_CREATOR_STORAGE_NAMESPACE=community-poc
